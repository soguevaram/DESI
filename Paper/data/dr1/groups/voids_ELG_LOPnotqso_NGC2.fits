SIMPLE  =                    T / conforms to FITS standard                      BITPIX  =                    8 / array data type                                NAXIS   =                    0 / number of array dimensions                     EXTEND  =                    T                                                  TRACER  = 'ELG_LOPnotqso'      / Tracer type                                    CAP     = 'NGC2    '           / Sky cap                                        NVOIDS  =                  685 / Number of voids                                H       =               0.6736 / h = H0 / 100                                   OMEGA_M =                0.315 / Matter density parameter                       RTHRESH =                -0.25 / R threshold for watershed                      WMODE   = 'underdense'         / Watershed mode                                 UNITSXYZ= 'Mpc/h   '           / Units for X,Y,Z,R_EFF,SEMI_AXIS_* columns      UNITSANG= 'deg     '           / Units for RA and DEC                           ELLIPDEF= '1-C/A   '           / Ellipticity definition                         PTUNITSX= 'Mpc/h   '           / Units for X_CART,Y_CART,Z_CART in POINT_MEMBERSPTUNITSR= 'dimensionless'      / Units for R in POINT_MEMBERSHIP                PTUNITSZ= 'redshift'           / Units for Z in POINT_MEMBERSHIP                GIDM1   =                   -1 / GROUPID=-1 means unassigned point              NPOINTS =                60676 / Number of points in POINT_MEMBERSHIP table     END                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             XTENSION= 'BINTABLE'           / binary table extension                         BITPIX  =                    8 / array data type                                NAXIS   =                    2 / number of array dimensions                     NAXIS1  =                   96 / length of dimension 1                          NAXIS2  =                  685 / length of dimension 2                          PCOUNT  =                    0 / number of group parameters                     GCOUNT  =                    1 / number of groups                               TFIELDS =                   14 / number of table fields                         TTYPE1  = 'VOID_ID '                                                            TFORM1  = 'J       '                                                            TTYPE2  = 'N_DATA_IN_GROUP'                                                     TFORM2  = 'J       '                                                            TTYPE3  = 'N_RAND_IN_GROUP'                                                     TFORM3  = 'J       '                                                            TTYPE4  = 'RA      '                                                            TFORM4  = 'D       '                                                            TTYPE5  = 'DEC     '                                                            TFORM5  = 'D       '                                                            TTYPE6  = 'REDSHIFT'                                                            TFORM6  = 'D       '                                                            TTYPE7  = 'X       '                                                            TFORM7  = 'D       '                                                            TTYPE8  = 'Y       '                                                            TFORM8  = 'D       '                                                            TTYPE9  = 'Z       '                                                            TFORM9  = 'D       '                                                            TTYPE10 = 'R_EFF   '                                                            TFORM10 = 'D       '                                                            TTYPE11 = 'SEMI_AXIS_A'                                                         TFORM11 = 'D       '                                                            TTYPE12 = 'SEMI_AXIS_B'                                                         TFORM12 = 'D       '                                                            TTYPE13 = 'SEMI_AXIS_C'                                                         TFORM13 = 'D       '                                                            TTYPE14 = 'ELLIP   '                                                            TFORM14 = 'E       '                                                            EXTNAME = 'VOIDS   '           / extension name                                 END                                                                                                                                                             